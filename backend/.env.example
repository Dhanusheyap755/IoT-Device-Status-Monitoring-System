# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# For Local: mongodb://127.0.0.1:27017/iot_monitoring
# For Render / Atlas Production: mongodb+srv://<username>:<password>@cluster.mongodb.net/iot_monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/iot_monitoring

# Allowed Frontend Origin for CORS
# For Local: http://localhost:5173
# For Production: https://<YOUR-USERNAME>.github.io
FRONTEND_URL=http://localhost:5173
